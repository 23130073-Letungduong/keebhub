# ===== Cơ bản =====
PORT=3000
BASE_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/keebhub
SESSION_SECRET=doi-chuoi-bi-mat-nay

# ===== Email (đăng ký / quên mật khẩu) =====
# Gmail: bật xác minh 2 bước -> tạo "App password" tại https://myaccount.google.com/apppasswords
# Để trống SMTP_HOST thì email sẽ được in ra console và xem tại http://localhost:3000/dev/mails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="KeebHub <no-reply@keebhub.vn>"

# ===== VNPay sandbox =====
# Đăng ký tài khoản test: https://sandbox.vnpayment.vn/devreg/
# Để trống thì web dùng trang "Mô phỏng VNPay" để demo luồng thanh toán.
VNP_TMNCODE=
VNP_HASHSECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:3000/payment/vnpay_return

# ===== Đăng nhập Google =====
# https://console.cloud.google.com/apis/credentials -> OAuth client ID (Web)
# Authorized redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== Đăng nhập Facebook =====
# https://developers.facebook.com/apps -> Facebook Login
# Valid OAuth Redirect URI: http://localhost:3000/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ===== Chat AI hỗ trợ =====
# Điền 1 trong 2. Để trống thì trợ lý chạy chế độ trả lời theo luật + tìm sản phẩm trong CSDL.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
