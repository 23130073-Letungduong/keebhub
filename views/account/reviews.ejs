<%- include('../partials/head') %>
<%- include('../partials/header') %>
<div class="ct"><div class="acct">
  <%- include('_nav') %>
  <div>
    <% if (pending.length) { %>
    <div class="pnl"><div class="hd"><div><h2>Chờ đánh giá</h2><p>Các đơn đã giao có sản phẩm chưa đánh giá</p></div></div>
      <div class="bd" style="padding:0">
        <% pending.forEach(function(o){ %><div class="oi" style="border-bottom:1px solid var(--border)"><div class="th"><img src="<%= o.items[0].image %>" class="kb"></div><div style="flex:1"><div class="nm">#<%= o.code %> · <%= o.shop.name %></div><div class="vr"><%= o.items.filter(function(i){return !i.reviewed}).length %> sản phẩm chưa đánh giá</div></div><a class="btn outp sm" href="/account/orders/<%= o.code %>/review">⭐ Đánh giá</a></div><% }) %>
      </div></div>
    <% } %>
    <div class="pnl"><div class="hd"><h2>Đánh giá của tôi (<%= reviews.length %>)</h2></div>
      <div class="bd">
        <% if (!reviews.length) { %><p class="muted s14">Bạn chưa viết đánh giá nào.</p><% } %>
        <% reviews.forEach(function(r){ %>
        <div class="rvitem"><% if (r.product) { %><a href="/p/<%= r.product.slug %>" style="width:60px;height:60px;border-radius:10px;overflow:hidden;border:1px solid var(--border);flex:none"><img src="<%= r.product.image %>" class="kb"></a><% } %>
          <div style="flex:1"><b class="s14"><%= r.product ? r.product.name : '(đã xoá)' %></b><div class="stars"><%= h.stars(r.rating) %> <span class="s12 muted"><%= h.date(r.createdAt) %></span></div><p class="s13 t2" style="margin-top:6px"><%= r.content %></p>
            <% if (r.images.length) { %><div class="rvph"><% r.images.forEach(function(i){ %><i><img src="<%= i %>" style="width:100%;height:100%;object-fit:cover"></i><% }) %></div><% } %>
            <% if (r.reply && r.reply.content) { %><div class="reply"><b class="s13">Phản hồi của shop</b><p class="s13 t2"><%= r.reply.content %></p></div><% } %></div></div>
        <% }) %>
      </div></div>
  </div>
</div></div>
<%- include('../partials/footer') %>
