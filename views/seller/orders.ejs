<%- include('_top') %>
<div class="card2">
  <div class="toolrow">
    <% [['all','Tất cả'],['pending','Chờ xác nhận'],['confirmed','Đã xác nhận'],['processing','Đang gia công'],['shipping','Đang giao'],['delivered','Đã giao'],['completed','Hoàn thành'],['cancelled','Đã huỷ']].forEach(function(t){ %>
      <a class="tchip <%= st===t[0]?'on':'' %>" href="?status=<%= t[0] %>"><%= t[1] %><%= t[0]!=='all' && counts[t[0]] ? ' ('+counts[t[0]]+')' : '' %></a><% }) %>
    <form class="mla f" style="gap:6px"><input type="hidden" name="status" value="<%= st %>"><select class="tchip" name="type" onchange="this.form.submit()"><option value="">Mọi loại đơn</option><option value="normal" <%= query.type==='normal'?'selected':'' %>>Bán lẻ</option><option value="custom" <%= query.type==='custom'?'selected':'' %>>Custom</option></select></form>
  </div>
  <div class="bd p0 tblx"><table class="tb">
    <tr><th>Mã đơn</th><th>Khách hàng</th><th>Sản phẩm</th><th>Giá trị</th><th>Thanh toán</th><th>Trạng thái</th><th>Ngày đặt</th><th></th></tr>
    <% orders.forEach(function(o){ %>
    <tr><td><b>#<%= o.code %></b><% if (o.isCustom) { %><div class="sub">Build #<%= o.buildCode %></div><% } %></td>
      <td><div class="nm"><%= o.user ? o.user.name : '' %></div><div class="sub"><%= o.shipping.phone %></div></td>
      <td><div class="nm"><%= o.items[0] ? o.items[0].name : '' %></div><div class="sub"><%= o.items.length > 1 ? '+' + (o.items.length-1) + ' sản phẩm' : '' %><%= o.isCustom ? ' · ' + o.service.name : '' %></div></td>
      <td><b><%= h.money(o.total) %></b></td>
      <td><span class="bdg <%= PAY[o.paymentStatus].cls %>"><%= o.paymentMethod==='cod' && o.paymentStatus==='unpaid' ? 'COD' : PAY[o.paymentStatus].label %></span></td>
      <td><span class="bdg <%= STATUS[o.status].cls %>"><%= STATUS[o.status].label %></span></td>
      <td class="muted"><%= h.dateTime(o.createdAt) %></td>
      <td style="text-align:right"><a class="btn out sm" href="/seller/orders/<%= o.code %>">Xử lý</a></td></tr>
    <% }) %>
    <% if (!orders.length) { %><tr><td colspan="8" class="muted" style="text-align:center;padding:30px">Không có đơn hàng.</td></tr><% } %>
  </table></div>
  <%- include('../partials/pager', {pages:pages, page:page}) %>
</div>
<%- include('_bottom') %>
