<%- include('../partials/head') %>
<%- include('../partials/header') %>
<div class="ct" style="max-width:760px">
  <div class="crumb"><a href="/">Trang chủ</a><span>›</span><b>Đăng ký bán hàng</b></div>
  <form class="card p24" method="post" action="/seller/register">
    <h1 class="s24 w800">🏪 Mở shop trên KeebHub</h1>
    <p class="s14 t2" style="margin:6px 0 20px">Điền thông tin shop. Sau khi quản trị viên duyệt, bạn có thể đăng sản phẩm và nhận đơn gia công.</p>
    <div class="field" style="margin-bottom:14px"><label>Tên shop</label><input class="inp" name="name" value="<%= form.name||'' %>" required minlength="3"></div>
    <div class="field" style="margin-bottom:14px"><label>Giới thiệu</label><textarea class="inp" name="description" rows="3"><%= form.description||'' %></textarea></div>
    <div class="grid2" style="margin-bottom:14px">
      <div class="field"><label>Số điện thoại shop</label><input class="inp" name="phone" value="<%= form.phone||'' %>"></div>
      <div class="field"><label>Tỉnh / thành phố</label><input class="inp" name="city" value="<%= form.city||'' %>" placeholder="TP.HCM"></div>
    </div>
    <div class="field" style="margin-bottom:14px"><label>Địa chỉ kho / xưởng</label><input class="inp" name="address" value="<%= form.address||'' %>"></div>
    <label class="f ac s14" style="gap:9px;margin-bottom:20px"><input type="checkbox" name="offersCustom" <%= form.offersCustom?'checked':'' %>> Shop có xưởng nhận gia công custom (lube, lắp ráp, hàn mạch)</label>
    <button class="btn pri lg">Gửi hồ sơ</button>
  </form>
</div>
<%- include('../partials/footer') %>
