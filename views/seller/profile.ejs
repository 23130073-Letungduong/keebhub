<%- include('_top') %>
<form class="card2" method="post" action="/seller/profile" style="max-width:820px">
  <div class="cover"></div><div class="avbig" style="background:<%= shop.color %>"><%= shop.initials %></div>
  <div class="bd">
    <div class="g2">
      <div class="field2"><label>Tên shop</label><input class="inp" name="name" value="<%= shop.name %>" required></div>
      <div class="field2"><label>Màu thương hiệu</label><input class="inp" type="color" name="color" value="<%= shop.color %>" style="padding:2px;height:42px"></div>
      <div class="field2"><label>Số điện thoại</label><input class="inp" name="phone" value="<%= shop.phone %>"></div>
      <div class="field2"><label>Tỉnh / thành</label><input class="inp" name="city" value="<%= shop.city %>"></div>
    </div>
    <div class="field2"><label>Địa chỉ</label><input class="inp" name="address" value="<%= shop.address %>"></div>
    <div class="field2"><label>Giới thiệu</label><textarea class="inp" name="description" rows="4"><%= shop.description %></textarea></div>
    <div class="f ac" style="gap:10px"><button class="btn pri">Lưu hồ sơ</button><a class="btn out" href="/shop/<%= shop.slug %>" target="_blank">Xem trang shop ↗</a><span class="mla s12 muted">Trạng thái: <b><%= shop.verified ? 'Đã xác minh' : 'Chưa xác minh' %></b> · ★ <%= shop.rating||'—' %> (<%= shop.reviewCount %>)</span></div>
  </div>
</form>
<%- include('_bottom') %>
