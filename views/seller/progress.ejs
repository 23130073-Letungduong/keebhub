<%- include('_top') %>
<div class="split">
  <div>
    <% if (!sel) { %><div class="card2"><div class="bd empty"><div class="s38">🛠</div><b>Chưa có đơn nào đang gia công</b><p class="s13 muted">Nhận yêu cầu tại mục "Đơn custom chờ xác nhận".</p></div></div>
    <% } else { var o = sel; %>
    <div class="card2">
      <div class="hd"><div style="flex:1"><h3>Đơn #<%= o.code %> · Build #<%= o.buildCode %></h3><p><%= o.user.name %> · Nhận <%= h.date(o.customRequest.respondedAt) %> · Cam kết bàn giao <%= h.date(o.customRequest.deadline) %></p></div><span class="bdg warn">Đang gia công · <%= o.progressPercent %>%</span></div>
      <div class="bd">
        <div class="cap"><div class="tk"><i style="width:<%= o.progressPercent %>%;background:linear-gradient(90deg,var(--p500),var(--s600))"></i></div><b><%= o.progress.filter(function(s){return s.status==='done'}).length %>/<%= o.progress.length %> công đoạn</b></div>
        <div class="steplist" style="margin-top:8px">
        <% o.progress.forEach(function(s,i){ %>
          <div class="stepitem <%= s.status==='done'?'done':s.status==='doing'?'cur':'' %>">
            <span class="n"><%= s.status==='done' ? '✓' : i+1 %></span>
            <div style="flex:1">
              <div class="f jb ac"><b class="s14"><%= s.name %></b><span class="s12 muted"><%= s.doneAt ? h.dateTime(s.doneAt) : s.status==='doing' ? 'Đang làm' : 'Chưa bắt đầu' %></span></div>
              <% if (s.status==='done') { %>
                <% if (s.note) { %><p class="s13 t2" style="margin-top:4px"><%= s.note %></p><% } %>
                <% if (s.photos.length) { %><div class="ph"><% s.photos.forEach(function(p){ %><a href="<%= p %>" target="_blank"><i><img src="<%= p %>" style="width:100%;height:100%;object-fit:cover"></i></a><% }) %></div><% } %>
              <% } else if (s.status==='doing') { %>
                <form method="post" action="/seller/progress/<%= o.code %>/stage/<%= s._id %>" enctype="multipart/form-data" style="margin-top:10px">
                  <div class="field2"><label>Ghi chú công đoạn (khách sẽ thấy)</label><textarea class="inp" name="note" rows="3" placeholder="Mô tả công việc đã làm…"><%= s.note %></textarea></div>
                  <% if (s.photos.length) { %><div class="ph" style="margin-bottom:10px"><% s.photos.forEach(function(p){ %><i><img src="<%= p %>" style="width:100%;height:100%;object-fit:cover"></i><% }) %></div><% } %>
                  <div class="upl2"><label style="cursor:pointer">📷 <b>Thêm ảnh thực tế</b><input type="file" name="photos" accept="image/*" multiple hidden></label><div class="s12 muted filelbl" style="margin-top:4px">Ảnh giúp khách yên tâm và giảm khiếu nại.</div></div>
                  <div class="f" style="gap:8px;margin-top:12px"><button class="btn pri" name="action" value="done">Lưu & hoàn thành bước này</button><button class="btn out" name="action" value="save">Chỉ lưu nháp</button></div>
                </form>
              <% } %>
            </div>
          </div>
        <% }) %>
        </div>
      </div>
    </div>
    <% } %>
  </div>
  <div>
    <% if (sel) { %>
    <div class="card2"><div class="hd"><h3>Build Sheet</h3></div><div class="bd">
      <div class="bsheet2"><% sel.items.forEach(function(i){ %><div class="r"><span><%= ({kit:'Kit',switch:'Switch',keycap:'Keycap',stab:'Stab'})[i.role]||'' %></span><b><%= i.name %></b></div><% }) %><div class="r"><span>Gói</span><b><%= sel.service.name %></b></div></div>
      <% if (sel.note) { %><div class="alert info s12" style="margin-top:10px">📝 <%= sel.note %></div><% } %>
      <a class="btn out blk sm" style="margin-top:12px" href="/seller/orders/<%= sel.code %>">Xem chi tiết đơn</a>
    </div></div>
    <% } %>
    <div class="card2"><div class="hd"><h3>Hàng đợi xưởng (<%= queue.length %>)</h3></div><div class="bd p0"><table class="tb">
      <tr><th>Đơn</th><th>Tiến độ</th><th>Hạn</th></tr>
      <% queue.forEach(function(o){ var late = o.customRequest.deadline && new Date(o.customRequest.deadline) < new Date(Date.now()+86400e3); %><tr style="<%= sel && sel.code===o.code ? 'background:var(--p50)' : '' %>"><td><a href="?code=<%= o.code %>"><b>#<%= o.code %></b><div class="sub"><%= o.user.name %></div></a></td><td><div class="cap" style="padding:0;min-width:90px"><div class="tk"><i style="width:<%= o.progressPercent %>%;background:var(--p500)"></i></div><b class="s12"><%= o.progressPercent %>%</b></div></td><td><span class="bdg <%= late?'err':'ok' %>"><%= h.date(o.customRequest.deadline).slice(0,5) %></span></td></tr><% }) %>
    </table></div></div>
    <% if (done.length) { %><div class="card2"><div class="hd"><h3>Đã hoàn thành gần đây</h3></div><div class="bd" style="padding:6px 20px"><% done.forEach(function(o){ %><div class="todo"><em style="background:var(--s50);color:var(--s600)">✓</em><div><b>#<%= o.code %></b><span><%= o.user?o.user.name:'' %> · <%= STATUS[o.status].label %></span></div></div><% }) %></div></div><% } %>
  </div>
</div>
<%- include('_bottom') %>
