<%- include('../partials/head') %>
<div class="app"><div class="rail" id="rail">
  <div class="brand"><span class="mark">K</span><div><b>KeebHub Admin</b><span>Quản trị hệ thống</span></div></div>
  <div class="shopbox"><span class="lg" style="background:#1B62F5"><%= user.initials %></span><div><b><%= user.name %></b><span>Toàn quyền hệ thống</span></div></div>
  <div class="gt">TỔNG QUAN</div><a class="<%= active==='dash'?'on':'' %>" href="/admin"><em><%- h.uiIcon('dashboard', 18) %></em>Bảng điều khiển</a>
  <div class="gt">NGƯỜI DÙNG</div>
  <a class="<%= active==='users'?'on':'' %>" href="/admin/users"><em><%- h.uiIcon('users', 18) %></em>Quản lý người dùng</a>
  <a class="<%= active==='shops'?'on':'' %>" href="/admin/shops"><em><%- h.uiIcon('store', 18) %></em>Tài khoản Seller/Shop<% if (badges.pendingShops) { %><b><%= badges.pendingShops %></b><% } %></a>
  <div class="gt">SẢN PHẨM</div>
  <a class="<%= active==='products'&&query.status!=='all'?'on':'' %>" href="/admin/products"><em><%- h.uiIcon('check', 18) %></em>Kiểm duyệt sản phẩm<% if (badges.pendingProducts) { %><b><%= badges.pendingProducts %></b><% } %></a>
  <a class="<%= active==='products'&&query.status==='all'?'on':'' %>" href="/admin/products?status=all"><em><%- h.uiIcon('list', 18) %></em>Tất cả sản phẩm</a>
  <a class="<%= active==='compat'?'on':'' %>" href="/admin/compat"><em><%- h.uiIcon('puzzle', 18) %></em>Danh mục & tương thích</a>
  <div class="gt">VẬN HÀNH</div>
  <a class="<%= active==='orders'?'on':'' %>" href="/admin/orders"><em><%- h.uiIcon('package', 18) %></em>Quản lý đơn hàng</a>
  <a class="<%= active==='refunds'?'on':'' %>" href="/admin/refunds"><em><%- h.uiIcon('undo', 18) %></em>Huỷ đơn & hoàn tiền<% if (badges.refunds) { %><b><%= badges.refunds %></b><% } %></a>
  <div class="gt">BÁO CÁO</div>
  <a class="<%= active==='revenue'?'on':'' %>" href="/admin/revenue"><em><%- h.uiIcon('trend', 18) %></em>Doanh thu & thống kê</a>
  <div class="gt">KHÁC</div>
  <a href="/"><em><%- h.uiIcon('external', 18) %></em>Về trang mua sắm</a>
  <form method="post" action="/auth/logout"><button class="railbtn"><em><%- h.uiIcon('logout', 18) %></em>Đăng xuất</button></form>
</div>
<div style="min-width:0"><div class="tbar">
  <button class="ib menu-tg" type="button" onclick="document.getElementById('rail').classList.toggle('open')"><%- h.uiIcon('menu', 20) %></button>
  <div><h1><%= title %></h1><div class="sub">KeebHub · <%= h.date(new Date()) %></div></div>
  <form class="sbox" action="/admin/orders"><span class="i"><%- h.uiIcon('search', 16) %></span><input name="q" placeholder="Tìm mã đơn hàng…"></form>
  <div class="who"><span class="av" style="background:#1B62F5"><%= user.initials %></span><span class="s13 w600"><%= user.name %> · Admin</span></div>
  <button type="button" class="thm-btn" data-theme-toggle title="Chuyển chế độ sáng / tối" aria-label="Chuyển chế độ sáng / tối"><span class="i-moon"><%- h.uiIcon('moon', 18) %></span><span class="i-sun"><%- h.uiIcon('sun', 18) %></span></button>
</div>
<div class="main">
<%- include('../partials/flash') %>
