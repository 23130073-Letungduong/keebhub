<% if (typeof flash !== 'undefined' && flash) { %>
<div class="flashes">
<% ['success','error','info'].forEach(function(k){ (flash[k]||[]).forEach(function(m){ %>
  <div class="alert <%= k==='success'?'ok':k==='error'?'err':'info' %> flash"><span><%- h.uiIcon(k==='success'?'check':k==='error'?'alert':'info', 18) %></span><div><%= m %></div><button type="button" class="x" onclick="this.parentNode.remove()">×</button></div>
<% }) }) %>
</div>
<% } %>
