<%- include('../partials/head') %>
<div class="auth">
<%- include('_aside', {heading: kind==='verify' ? 'Sắp xong rồi!' : 'Kiểm tra hộp thư', sub:'Mở email từ KeebHub và bấm vào liên kết để tiếp tục.'}) %>
<div class="apane"><div class="aform" style="text-align:center">
  <div style="text-align:left"><%- include('../partials/flash') %></div>
  <div style="width:76px;height:76px;border-radius:50%;background:var(--p50);display:grid;place-items:center;font-size:34px;margin:0 auto 18px"><%- h.uiIcon('mail', 34) %></div>
  <h1 class="s24 w800"><%= kind==='verify' ? 'Xác nhận email của bạn' : 'Đã gửi liên kết đặt lại' %></h1>
  <p class="s14 t2" style="margin-top:10px;line-height:1.7">Chúng tôi đã gửi email tới <b><%= email %></b>.<br><%= kind==='verify' ? 'Bấm vào liên kết trong email để kích hoạt tài khoản (hiệu lực 24 giờ).' : 'Nếu email tồn tại trong hệ thống, bạn sẽ nhận được liên kết (hiệu lực 30 phút).' %></p>
  <% if (!mailReady) { %><div class="alert err" style="margin-top:18px;text-align:left"><span><%- h.uiIcon('alert', 18) %></span><div><b>Hệ thống chưa cấu hình gửi email</b> nên email chưa được gửi đi. Quản trị viên cần chạy <b>cau-hinh-email.bat</b> (điền Gmail + mật khẩu ứng dụng) rồi bạn thử lại.</div></div>
  <% } else if (typeof mailFailed !== 'undefined' && mailFailed && kind==='verify') { %><div class="alert err" style="margin-top:18px;text-align:left"><span><%- h.uiIcon('alert', 18) %></span><div>Hệ thống chưa gửi được email lúc này. Bạn bấm <b>Gửi lại email</b> sau ít phút, hoặc liên hệ letungduong.nvn@gmail.com để được kích hoạt.</div></div>
  <% } else { %><p class="s13 muted" style="margin-top:12px">Không thấy email? Hãy xem cả mục <b>Thư rác / Spam</b> hoặc tab <b>Quảng cáo</b> trong Gmail.</p><% } %>
  <% if (mailDev) { %><div class="alert warn" style="margin-top:18px;text-align:left"><%- h.uiIcon('inbox', 16) %> Web chưa cấu hình gửi email thật nên email được lưu tại <a href="/dev/mails" class="w700" style="text-decoration:underline">Hộp thư dev</a>.</div><% } %>
  <% if (kind==='verify') { %><form method="post" action="/auth/resend" style="margin-top:18px"><input type="hidden" name="email" value="<%= email %>"><button class="btn out" id="resendBtn" data-wait="<%= typeof cooldown !== 'undefined' ? cooldown : 30 %>">Gửi lại email</button></form>
  <script>/* Nút Gửi lại email: khoá 30 giây sau mỗi lần gửi */
  (function(){var b=document.getElementById('resendBtn');if(!b)return;var n=parseInt(b.dataset.wait,10)||0;
  function tick(){if(n>0){b.disabled=true;b.textContent='Gửi lại email sau '+n+'s';n--;setTimeout(tick,1000);}else{b.disabled=false;b.textContent='Gửi lại email';}}
  tick();b.form.addEventListener('submit',function(){b.disabled=true;b.textContent='Đang gửi…';});})();</script><% } %>
  <a class="btn pri blk" style="margin-top:14px" href="/auth/login">Về trang đăng nhập</a>
</div></div>
</div>
</body></html>
