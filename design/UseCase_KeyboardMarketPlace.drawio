tive="1" as="geometry"/></mxCell><mxCell id="e72" value="«extend»" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=0;strokeColor=#C77B2B;fontSize=10;fontColor=#C77B2B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n10" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e73" value="«extend»" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=0;strokeColor=#C77B2B;fontSize=10;fontColor=#C77B2B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n12" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n74" value="Association giữa Actor và Use Case là ĐƯỜNG THẲNG KHÔNG MŨI TÊN.&lt;br&gt;Giữa 2 use case chỉ có «include», «extend», generalization –&lt;br&gt;KHÔNG có mũi tên mang nghĩa &quot;rồi chuyển tiếp sang&quot;.&lt;br&gt;Luồng Customer → Sàn → Shop xem ở tab Activity Diagram." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;fillColor=#FFF9D9;strokeColor=#CDB86A;" vertex="1" parent="1"><mxGeometry x="120" y="90" width="330" height="130" as="geometry"/></mxCell><mxCell id="n75" value="Payment Gateway là ACTOR PHỤ: không sở hữu use case,&lt;br&gt;chỉ nối association tới UC06 và UC26." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;fillColor=#FFF9D9;strokeColor=#CDB86A;" vertex="1" parent="1"><mxGeometry x="120" y="990" width="330" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Activity - Luồng đơn Custom"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n3" value="SELLER / SHOP" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#FAFAFA;strokeColor=#999999;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="60" width="340" height="1680" as="geometry"/></mxCell><mxCell id="n2" value="HỆ THỐNG (SÀN)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#FAFAFA;strokeColor=#999999;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="60" width="420" height="1680" as="geometry"/></mxCell><mxCell id="n1" value="CUSTOMER" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#FAFAFA;strokeColor=#999999;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="60" width="300" height="1680" as="geometry"/></mxCell><mxCell id="n4" value="" style="ellipse;html=1;fillColor=#333333;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="235" y="120" width="30" height="30" as="geometry"/></mxCell><mxCell id="n5" value="Chọn kit, switch, keycap&lt;br&gt;&amp; gói gia công (UC04)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#555555;arcSize=20;" vertex="1" parent="1"><mxGeometry x="140" y="185" width="220" height="55" as="geometry"/></mxCell><mxCell id="n6" value="Kiểm tra độ tương thích&lt;br&gt;linh kiện (UC27)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#555555;arcSize=20;" vertex="1" parent="1"><mxGeometry x="430" y="265" width="220" height="55" as="geometry"/></mxCell><mxCell id="n7" value="Tương thích?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF9D9;strokeColor=#CDB86A;" vertex="1" parent="1"><mxGeometry x="485" y="350" width="120" height="70" as="geometry"/></mxCell><mxCell id="n8" value="Xem cảnh báo &amp;&lt;br&gt;chỉnh lại cấu hình" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#555555;arcSize=20;" vertex="1" parent="1"><mxGeometry x="140" y="355" width="220" height="55" as="geometry"/></mxCell><mxCell id="n9" value="Thêm vào giỏ &amp; đặt hàng&lt;br&gt;(UC05)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#555555;arcSize=20;" vertex="1" parent="1"><mxGeometry x="140" y="470" width=